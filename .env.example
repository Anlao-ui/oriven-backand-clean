# ═══════════════════════════════════════════════════════════════
# ORIVEN — Environment Variable Reference
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env (never commit .env — it is gitignored).
# In production, set these variables in the Render dashboard:
#   Render → Service → Environment → Environment Variables
#
# KEY TYPES:
#   BACKEND-ONLY  — secrets, never exposed to the browser
#   FRONTEND-SAFE — public values, safe in client-side code
# ═══════════════════════════════════════════════════════════════


# ── Supabase ─────────────────────────────────────────────────────
# FRONTEND-SAFE: Supabase Dashboard → Settings → API → Project URL
SUPABASE_URL=https://your-project-id.supabase.co

# BACKEND-ONLY: Supabase Dashboard → Settings → API → service_role key (labeled DANGER)
# Must be the service_role JWT, NOT the anon/publishable key.
SUPABASE_SERVICE_ROLE_KEY=eyJ...


# ── Stripe ───────────────────────────────────────────────────────
# BACKEND-ONLY. Never put any of these in the frontend.
# The key decides the mode: sk_test_… (or rk_test_…) = Test Mode,
# sk_live_… (or rk_live_…) = Live Mode. Use a TEST key locally and in staging;
# only production gets the live key. The backend picks the matching set of
# Price IDs below and refuses a price from the other mode.
STRIPE_SECRET_KEY=sk_test_...

# Stripe Dashboard → Developers → Webhooks → your endpoint → Signing secret.
# Test and Live endpoints have different secrets — use the one of this mode.
# Events: checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, checkout.session.expired,
# charge.refunded, charge.dispute.created, charge.dispute.closed
# (+ customer.subscription.updated, customer.subscription.deleted,
# invoice.payment_succeeded, invoice.payment_failed while
# legacy subscriptions exist).
STRIPE_WEBHOOK_SECRET=whsec_...

# The five access periods — ONE-TIME prices in EUR, tax behaviour
# "Inclusive" (VAT included), Stripe Tax enabled on the account.
# Stripe Dashboard → Product catalogue → product → price → Price ID (price_…).
#   Flex €17 (14 days, 1,050 credits)      Monthly €29 (1 month, 1,750)
#   Quarterly €78 (3 months, 4,800)        Semi-Annual €143 (6 months, 8,850)
#   Annual €245 (12 months, 15,000)
# Test Mode prices:
STRIPE_PRICE_FLEX_TEST=
STRIPE_PRICE_MONTHLY_TEST=
STRIPE_PRICE_QUARTERLY_TEST=
STRIPE_PRICE_SEMIANNUAL_TEST=
STRIPE_PRICE_ANNUAL_TEST=
# Live Mode prices:
STRIPE_PRICE_FLEX_LIVE=
STRIPE_PRICE_MONTHLY_LIVE=
STRIPE_PRICE_QUARTERLY_LIVE=
STRIPE_PRICE_SEMIANNUAL_LIVE=
STRIPE_PRICE_ANNUAL_LIVE=

# LEGACY (recognising existing customers' old monthly subscriptions only;
# no new subscriptions are sold). Leave as they are in production.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_PROFESSIONAL=


# ── AI / LLM ─────────────────────────────────────────────────────
# BACKEND-ONLY: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# BACKEND-ONLY: platform.openai.com → API keys
OPENAI_API_KEY=sk-...

# BACKEND-ONLY: app.heygen.com → Settings → API → API Key
HEYGEN_API_KEY=sk_V2_...


# ── SMTP / Email ──────────────────────────────────────────────────
# BACKEND-ONLY: Transactional email for verification and invites.
# Defaults to Outlook SMTP if HOST/PORT are omitted.
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_USER=you@outlook.com
SMTP_PASS=your-app-password

# Optional display name in From: header. Defaults to: ORIVEN <SMTP_USER>
SMTP_FROM=ORIVEN <no-reply@orivenai.com>


# ── Google OAuth + Ads ───────────────────────────────────────────
# BACKEND-ONLY: Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# BACKEND-ONLY: Google Ads UI → Tools → API Centre
GOOGLE_ADS_DEVELOPER_TOKEN=your-developer-token

# BACKEND-ONLY: Must match an Authorized redirect URI in Google Cloud Console.
# Auto-detected if unset: localhost:5500 (local) or Render URL (production).
# Always set this explicitly in Render environment variables.
GOOGLE_REDIRECT_URI=https://oriven-backand-clean.onrender.com/auth/google/callback


# ── App ───────────────────────────────────────────────────────────
# BACKEND-ONLY: Public frontend URL for Stripe redirects and email links.
# The Google OAuth redirect auto-detects local vs production WITHOUT this var —
# only set it if you change the frontend domain.
# Default if unset (production/Render): https://orivenai.com
# Default if unset (local dev):         http://localhost:5500
FRONTEND_URL=https://orivenai.com
